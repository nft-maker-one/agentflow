# AgentKit — example environment.
# Copy to `.env` and fill in only what you need. `.env` is gitignored.
# `agentkit serve` auto-detects which backends/LLMs to enable from the
# variables that are present (no key set → that provider/backend is off).
# Every `AGENTKIT_<MODULE>_*` name maps 1:1 to a field in the matching
# `src/agentkit/**/config.py` (pydantic-settings).

# ─────────────────────────────────────────────────────────────────────
# LLM providers — set the one(s) you use. Each accepts a common name,
# an `AGENTKIT_LLM_*` canonical name, and (some) the vendor alias.
# ─────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-your-key                 # alias: AGENTKIT_LLM_OPENAI_API_KEY
# DEEPSEEK_API_KEY=sk-your-key               # alias: AGENTKIT_LLM_DEEPSEEK_API_KEY
# DASHSCOPE_API_KEY=sk-your-key              # Qwen — aliases: QWEN_API_KEY / AGENTKIT_LLM_QWEN_API_KEY
# GEMINI_API_KEY=your-key                    # aliases: GOOGLE_API_KEY / AGENTKIT_LLM_GEMINI_API_KEY
# ANTHROPIC_API_KEY=sk-your-key              # alias: AGENTKIT_LLM_ANTHROPIC_API_KEY

# ─────────────────────────────────────────────────────────────────────
# External I/O — Telegram source/sink (optional)
# ─────────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token   # @BotFather token — alias: AGENTKIT_TELEGRAM_BOT_TOKEN
# TELEGRAM_CHAT_ID=-1001234567890            # fixed sink target chat — alias: AGENTKIT_TELEGRAM_CHAT_ID

# ─────────────────────────────────────────────────────────────────────
# External I/O — Email (SMTP send / IMAP receive, optional)
# ─────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com                 # alias: EMAIL_SMTP_HOST
# SMTP_PORT=465                              # SSL port (default 465)
# SMTP_USER=you@example.com                  # alias: EMAIL_USER
# SMTP_PASSWORD=your-app-password            # app password — alias: EMAIL_PASSWORD
# SMTP_TO=recipient@example.com              # default recipient — alias: EMAIL_TO
# SMTP_SUBJECT=AgentKit notification         # default subject (optional)
# IMAP_HOST=imap.example.com                 # alias: EMAIL_IMAP_HOST
# IMAP_PORT=993                              # SSL port (default 993)
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-app-password

# ─────────────────────────────────────────────────────────────────────
# Persistence — PostgreSQL (optional; default is in-memory).
# Setting either of these auto-selects the Postgres run/control-plane store.
# ─────────────────────────────────────────────────────────────────────
# AGENTKIT_PG_DSN=postgresql://agentkit:agentkit@localhost:5432/agentkit
# or the parts: AGENTKIT_PG_HOST / AGENTKIT_PG_PORT / AGENTKIT_PG_USER / AGENTKIT_PG_PASSWORD / AGENTKIT_PG_DB
# AGENTKIT_PG_POOL_MIN=2
# AGENTKIT_PG_POOL_MAX=10

# ─────────────────────────────────────────────────────────────────────
# Event bus backend. A single selector; the chosen middleware is
# TCP-probed before use and DEGRADES to the in-process bus if offline.
#   redis  (default) → Redis Streams. Best fit for AgentKit's many
#                      low-fan-out topics (O(1) consumer-group create,
#                      no rebalance) — deploy is ~5ms vs Kafka's ~6s.
#   kafka            → Kafka / Redpanda (opt-in).
#   memory           → in-process (zero deps).
# ─────────────────────────────────────────────────────────────────────
# AGENTKIT_BUS_BACKEND=redis
# -- redis backend --
# AGENTKIT_BUS_REDIS_URL=redis://localhost:6379/0   # falls back to AGENTKIT_REDIS_URL / guardrail URL
# AGENTKIT_BUS_KEY_PREFIX=ak
# AGENTKIT_BUS_MAXLEN=10000                          # per-stream XADD MAXLEN (bounds memory)
# -- kafka backend --
# AGENTKIT_BUS_BROKERS=localhost:9092               # comma-separated
# others via AGENTKIT_BUS_* (producer_acks / default_partitions / …)

# ─────────────────────────────────────────────────────────────────────
# Guardrail — Redis (optional; default is the in-process guardrail).
# Setting the URL auto-selects the Redis guardrail.
# ─────────────────────────────────────────────────────────────────────
# AGENTKIT_GUARDRAIL_REDIS_URL=redis://localhost:6379/0
# others via AGENTKIT_GUARDRAIL_* (fail_mode / default_reservation_ttl_ms / namespace_prefix …)

# ─────────────────────────────────────────────────────────────────────
# Logging / profile (prefix AGENTKIT_)
# ─────────────────────────────────────────────────────────────────────
AGENTKIT_LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
AGENTKIT_LOG_FORMAT=console                   # json | console
AGENTKIT_PROFILE=local                        # local | staging | prod

# ─────────────────────────────────────────────────────────────────────
# Observability (optional, prefix AGENTKIT_)
# ─────────────────────────────────────────────────────────────────────
# AGENTKIT_OTEL_ENDPOINT=http://localhost:4317
# AGENTKIT_TRACE_SAMPLE_RATE=1.0
# AGENTKIT_PROM_PORT=9000
# AGENTKIT_SERVICE_NAME=agentkit

# ─────────────────────────────────────────────────────────────────────
# Runtime concurrency / retry tuning (prefix AGENTKIT_RUNTIME_)
# ─────────────────────────────────────────────────────────────────────
# AGENTKIT_RUNTIME_DEFAULT_MAX_CONCURRENT=4   # per-instance concurrency (1 = strict serial)
# AGENTKIT_RUNTIME_MAX_HANDLER_RETRIES=3
# AGENTKIT_RUNTIME_HANDLER_TIMEOUT_MS=60000
